{
  "name": "@ordo/shared",
  "version": "0.1.0",
  "description": "Ordo 框架无关共享层：CLI 瘦客户端与 runtime 守护进程共用的协议/客户端/配置/CLI 适配器",
  "private": true,
  "license": "UNLICENSED",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./ordo-ref": {
      "types": "./dist/ordo-ref.d.ts",
      "default": "./dist/ordo-ref.js"
    },
    "./events/domain-events": {
      "types": "./dist/events/domain-events.d.ts",
      "default": "./dist/events/domain-events.js"
    },
    "./http/ordo-client": {
      "types": "./dist/http/ordo-client.d.ts",
      "default": "./dist/http/ordo-client.js"
    },
    "./http/envelope": {
      "types": "./dist/http/envelope.d.ts",
      "default": "./dist/http/envelope.js"
    },
    "./runtime/protocol": {
      "types": "./dist/runtime/protocol.d.ts",
      "default": "./dist/runtime/protocol.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "axios": "^1.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^20.3.1",
    "typescript": "^5.1.3",
    "vitest": "catalog:"
  }
}
